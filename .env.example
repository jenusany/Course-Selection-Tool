# Copy to .env and adjust as needed. Docker Compose defaults match this out of the box.
DATABASE_URL="postgresql://wcs:wcs_dev_password@localhost:5432/wcs"
REDIS_URL="redis://localhost:6379"

# Auth.js
AUTH_SECRET="dev-only-change-me"
AUTH_MODE="mock" # "mock" | "entra"

# Entra ID (only used when AUTH_MODE=entra)
AUTH_ENTRA_ID_TENANT_ID=""
AUTH_ENTRA_ID_CLIENT_ID=""
AUTH_ENTRA_ID_CLIENT_SECRET=""

# Chatbot (Phase 6)
CHAT_MODEL_PROVIDER="anthropic" # "anthropic" | "ollama"
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
